# Copier ce fichier en .env et renseigner les valeurs.

# Gemini — parsing des PDF
GEMINI_API_KEY=
GEMINI_PARSING_MODEL=gemini-2.5-flash

# Mistral — embeddings denses (1024 dimensions)
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Qdrant Cloud
QDRANT_URL=https://<cluster>.<region>.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# kDrive (Infomaniak)
KDRIVE_TOKEN=
KDRIVE_DRIVE_ID=
KDRIVE_SHARE_UUID=
